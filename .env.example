# Application & Container Configuration
APP_PORT=8080
APP_ENV=development
GIN_MODE=debug
LOG_LEVEL=debug
IMAGE_TAG=1.1.1
IMAGE_NAME=ghcr.io/nmhiepasd/task-manager-api

# Security & Authentication
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
JWT_ISSUER=task-manager-api
JWT_AUDIENCE=task-manager-client
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXIES=127.0.0.1,172.28.0.2
RATE_LIMIT_AUTH_RATE=0.166667
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW=1m
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION=15m
AUTH_LOCKOUT_WINDOW=15m
RATE_LIMIT_API_RATE=100
RATE_LIMIT_API_BURST=50
RATE_LIMIT_API_LIMIT=100
RATE_LIMIT_API_WINDOW=1m

# PostgreSQL Database & Connection Pooling
DB_URL=postgres://postgres:postgres@localhost:5432/task_manager?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=10s

# Redis & Caching
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DEFAULT_TTL=15m

# Background Worker & Asynq
WORKER_ENABLED=true
WORKER_CONCURRENCY=10
CLEANUP_CRON_SCHEDULE=@every 6h
DEADLINE_REMINDER_CRON_SCHEDULE=@hourly
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=120

# HTTP Server & Middleware Timeouts
REQUEST_TIMEOUT=30s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=60s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=60s

# Object Storage (MinIO / S3)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=task-attachments
S3_USE_SSL=false
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=10

# Webhooks
ALLOW_LOCAL_WEBHOOKS=false
WEBHOOK_MAX_RETRY=6
# 32-byte master key for AES-256 webhook secret encryption (raw 32-byte, 64-char hex, or 44-char base64)
WEBHOOK_ENCRYPTION_KEY=12345678901234567890123456789012

