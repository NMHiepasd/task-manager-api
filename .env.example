# Application Configuration
APP_PORT=8080
APP_ENV=development
GIN_MODE=debug
LOG_LEVEL=debug

# Security & Authentication
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_AUTH_RATE=0.166667
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_API_RATE=100
RATE_LIMIT_API_BURST=50
RATE_LIMIT_API_LIMIT=100
RATE_LIMIT_API_WINDOW=1m

# PostgreSQL Database & Connection Pooling
DB_URL=postgres://postgres:postgres@localhost:5432/task_manager?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=10s

# Redis & Caching
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DEFAULT_TTL=15m

# HTTP Server & Middleware Timeouts
REQUEST_TIMEOUT=30s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
