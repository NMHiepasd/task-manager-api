  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HTTP Traffic & RED Metrics (Rate, Errors, Duration)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "Request Rate (RPS by Status)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(taskmanager_http_requests_total[1m]))",
          "legendFormat": "Status {{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "showPoints": "never" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "HTTP Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(taskmanager_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 (Median)"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskmanager_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(taskmanager_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Infrastructure & Database Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20 },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "Active In-Flight HTTP Requests",
      "type": "timeseries",
      "targets": [
        {
          "expr": "taskmanager_http_in_flight_requests",
          "legendFormat": "In-Flight Requests"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15 },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "PostgreSQL Connection Pool Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "taskmanager_db_pool_total_conns",
          "legendFormat": "Total Connections"
        },
        {
          "expr": "taskmanager_db_pool_idle_conns",
          "legendFormat": "Idle Connections"
        },
        {
          "expr": "taskmanager_db_pool_acquired_conns",
          "legendFormat": "Acquired (In-Use)"
        }
      ]
    }
  ],
